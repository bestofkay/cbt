generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// IDENTITY & ACCESS
// =============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

model User {
  id                String     @id @default(uuid()) @db.Char(36)
  email             String     @unique @db.VarChar(320)
  emailVerifiedAt   DateTime?
  passwordHash      String?    @db.VarChar(255)
  firstName         String     @db.VarChar(100)
  lastName          String     @db.VarChar(100)
  displayName       String?    @db.VarChar(200)
  phone             String?    @db.VarChar(30)
  phoneVerifiedAt   DateTime?
  avatarUrl         String?    @db.VarChar(500)
  locale            String     @default("en") @db.VarChar(10)
  timezone          String     @default("UTC") @db.VarChar(64)
  status            UserStatus @default(PENDING_VERIFICATION)
  departmentId      String?    @db.Char(36)
  candidateId       String?    @unique @db.Char(36)
  lastLoginAt       DateTime?
  lastLoginIp       String?    @db.VarChar(45)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  mustChangePassword Boolean   @default(false)
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  department        Department? @relation(fields: [departmentId], references: [id])
  candidate         Candidate?  @relation(fields: [candidateId], references: [id])
  roles             UserRole[]
  refreshTokens     RefreshToken[]
  devices           Device[]
  fingerprints      BrowserFingerprint[]
  apiKeys           ApiKey[]
  twoFactor         TwoFactorSecret?
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]
  otpChallenges     OtpChallenge[]
  oauthAccounts     OAuthAccount[]
  auditLogs         AuditLog[]           @relation("AuditActor")
  authoredQuestions Question[]           @relation("QuestionAuthor")
  reviewedQuestions QuestionVersion[]    @relation("QuestionReviewer")
  examAttempts      ExamAttempt[]
  notifications     Notification[]
  supportTickets    SupportTicket[]      @relation("TicketRequester")
  assignedTickets   SupportTicket[]      @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  activityStreams   ActivityStream[]
  proctorSessions   ProctorSession[]     @relation("ProctorUser")
  certificates      Certificate[]
  payments          Payment[]
  invoices          Invoice[]

  @@index([status])
  @@index([departmentId])
  @@index([lastName, firstName])
  @@index([createdAt])
  @@map("users")
}

model Department {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @db.VarChar(200)
  code        String    @unique @db.VarChar(50)
  description String?   @db.Text
  parentId    String?   @db.Char(36)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentTree")
  users    User[]

  @@index([parentId])
  @@map("departments")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  resource    String   @db.VarChar(80)
  action      String   @db.VarChar(40)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Char(36)
  roleId     String   @db.Char(36)
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @db.Char(36)
  tokenHash       String    @unique @db.VarChar(128)
  familyId        String    @db.Char(36)
  deviceId        String?   @db.Char(36)
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?   @db.Char(36)
  ipAddress       String?   @db.VarChar(45)
  userAgent       String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Device {
  id            String    @id @default(uuid()) @db.Char(36)
  userId        String    @db.Char(36)
  name          String?   @db.VarChar(200)
  deviceType    String?   @db.VarChar(50)
  os            String?   @db.VarChar(80)
  browser       String?   @db.VarChar(80)
  trusted       Boolean   @default(false)
  trustedAt     DateTime?
  lastSeenAt    DateTime?
  lastIp        String?   @db.VarChar(45)
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprints BrowserFingerprint[]
  refreshTokens RefreshToken[]

  @@index([userId, trusted])
  @@map("devices")
}

model BrowserFingerprint {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @db.Char(36)
  deviceId    String?  @db.Char(36)
  hash        String   @db.VarChar(128)
  components  Json
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@unique([userId, hash])
  @@index([hash])
  @@map("browser_fingerprints")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  name       String    @db.VarChar(120)
  keyPrefix  String    @db.VarChar(12)
  keyHash    String    @unique @db.VarChar(128)
  scopes     Json
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model TwoFactorSecret {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @unique @db.Char(36)
  secretEnc   String    @db.VarChar(500)
  enabled     Boolean   @default(false)
  verifiedAt  DateTime?
  backupCodes Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model OtpChallenge {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  purpose   String    @db.VarChar(40)
  codeHash  String    @db.VarChar(128)
  channel   String    @db.VarChar(20)
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_challenges")
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @db.Char(36)
  provider       String   @db.VarChar(40)
  providerUserId String   @db.VarChar(200)
  email          String?  @db.VarChar(320)
  accessTokenEnc String?  @db.Text
  refreshTokenEnc String? @db.Text
  expiresAt      DateTime?
  profile        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Candidate {
  id              String    @id @default(uuid()) @db.Char(36)
  externalId      String?   @unique @db.VarChar(100)
  nationalId      String?   @db.VarChar(100)
  dateOfBirth     DateTime? @db.Date
  gender          String?   @db.VarChar(20)
  addressLine1    String?   @db.VarChar(200)
  addressLine2    String?   @db.VarChar(200)
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  postalCode      String?   @db.VarChar(30)
  country         String?   @db.VarChar(2)
  emergencyContact Json?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user            User?
  invitations     ExamInvitation[]
  attempts        ExamAttempt[]

  @@index([country])
  @@map("candidates")
}

// =============================================================================
// QUESTION BANK
// =============================================================================

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  TRUE_FALSE
  ESSAY
  NUMERIC
  CODE_EDITOR
  SQL_QUERY
  FILL_BLANK
  MATCHING
  ORDERING
  MATRIX
  HOTSPOT
  IMAGE_SELECTION
  VIDEO_QUESTION
  AUDIO_QUESTION
  DRAG_DROP
  CASE_STUDY
  PROGRAMMING_CHALLENGE
}

enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model Language {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(80)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  questions QuestionVersion[]

  @@map("languages")
}

model ExamCategory {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(150)
  description String?   @db.Text
  parentId    String?   @db.Char(36)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   ExamCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ExamCategory[] @relation("CategoryTree")
  banks    QuestionBank[]
  exams    ExamTemplate[]

  @@index([parentId])
  @@map("exam_categories")
}

model QuestionBank {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @db.VarChar(200)
  code        String    @unique @db.VarChar(50)
  description String?   @db.Text
  categoryId  String?   @db.Char(36)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category  ExamCategory? @relation(fields: [categoryId], references: [id])
  questions Question[]
  topics    Topic[]

  @@index([categoryId])
  @@index([isActive])
  @@map("question_banks")
}

model Topic {
  id        String   @id @default(uuid()) @db.Char(36)
  bankId    String   @db.Char(36)
  name      String   @db.VarChar(150)
  code      String   @db.VarChar(50)
  parentId  String?  @db.Char(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bank     QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  parent   Topic?       @relation("TopicTree", fields: [parentId], references: [id])
  children Topic[]      @relation("TopicTree")
  questions Question[]

  @@unique([bankId, code])
  @@index([parentId])
  @@map("topics")
}

model Tag {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(80)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now())

  questions QuestionTag[]

  @@map("tags")
}

model Question {
  id              String         @id @default(uuid()) @db.Char(36)
  bankId          String         @db.Char(36)
  topicId         String?        @db.Char(36)
  code            String         @db.VarChar(50)
  type            QuestionType
  difficulty      Difficulty     @default(MEDIUM)
  status          QuestionStatus @default(DRAFT)
  currentVersion  Int            @default(1)
  authorId        String         @db.Char(36)
  pointsDefault   Decimal        @default(1) @db.Decimal(10, 2)
  negativeMarking Decimal        @default(0) @db.Decimal(10, 2)
  partialScoring  Boolean        @default(false)
  estimatedSeconds Int?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  bank     QuestionBank      @relation(fields: [bankId], references: [id])
  topic    Topic?            @relation(fields: [topicId], references: [id])
  author   User              @relation("QuestionAuthor", fields: [authorId], references: [id])
  versions QuestionVersion[]
  tags     QuestionTag[]
  media    MediaAsset[]
  examRules ExamQuestionRule[]
  attemptAnswers AttemptAnswer[]

  @@unique([bankId, code])
  @@index([bankId, status, type])
  @@index([topicId])
  @@index([difficulty])
  @@index([authorId])
  @@map("questions")
}

model QuestionTag {
  questionId String @db.Char(36)
  tagId      String @db.Char(36)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model QuestionVersion {
  id              String         @id @default(uuid()) @db.Char(36)
  questionId      String         @db.Char(36)
  version         Int
  languageId      String         @db.Char(36)
  stem            String         @db.LongText
  stemFormat      String         @default("markdown") @db.VarChar(20)
  stemHtml        String?        @db.LongText
  latexBlocks     Json?
  randomVariables Json?
  hints           Json?
  solution        String?        @db.LongText
  solutionFormat  String?        @db.VarChar(20)
  gradingRubric   Json?
  autoGradeConfig Json?
  status          QuestionStatus @default(DRAFT)
  reviewerId      String?        @db.Char(36)
  reviewedAt      DateTime?
  reviewNotes     String?        @db.Text
  changeSummary   String?        @db.VarChar(500)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  question Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language Language              @relation(fields: [languageId], references: [id])
  reviewer User?                 @relation("QuestionReviewer", fields: [reviewerId], references: [id])
  choices  Choice[]
  workflows ApprovalWorkflow[]

  @@unique([questionId, version, languageId])
  @@index([status])
  @@index([reviewerId])
  @@map("question_versions")
}

model Choice {
  id               String   @id @default(uuid()) @db.Char(36)
  questionVersionId String  @db.Char(36)
  label            String   @db.VarChar(10)
  content          String   @db.Text
  contentFormat    String   @default("markdown") @db.VarChar(20)
  isCorrect        Boolean  @default(false)
  weight           Decimal  @default(0) @db.Decimal(10, 4)
  sortOrder        Int      @default(0)
  matchKey         String?  @db.VarChar(100)
  metadata         Json?
  createdAt        DateTime @default(now())

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@index([questionVersionId, sortOrder])
  @@map("choices")
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  RESUBMITTED
}

model ApprovalWorkflow {
  id                String         @id @default(uuid()) @db.Char(36)
  questionVersionId String         @db.Char(36)
  action            ApprovalAction
  actorId           String         @db.Char(36)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now())

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@index([questionVersionId, createdAt])
  @@map("approval_workflows")
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

model MediaAsset {
  id           String    @id @default(uuid()) @db.Char(36)
  questionId   String?   @db.Char(36)
  type         MediaType
  filename     String    @db.VarChar(255)
  mimeType     String    @db.VarChar(120)
  sizeBytes    BigInt
  storageKey   String    @db.VarChar(500)
  url          String?   @db.VarChar(1000)
  checksum     String?   @db.VarChar(128)
  altText      String?   @db.VarChar(500)
  metadata     Json?
  uploadedById String?   @db.Char(36)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  question Question? @relation(fields: [questionId], references: [id])

  @@index([questionId])
  @@index([storageKey])
  @@map("media_assets")
}

// =============================================================================
// EXAMS
// =============================================================================

enum ExamMode {
  PRACTICE
  MOCK
  REAL
  LIVE
}

enum ExamAccessType {
  OPEN
  INVITATION_ONLY
  ACCESS_CODE
  SCHEDULED
}

enum ExamSessionStatus {
  DRAFT
  PUBLISHED
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  AUTO_SUBMITTED
  UNDER_REVIEW
  GRADED
  VOIDED
}

model ExamTemplate {
  id                 String         @id @default(uuid()) @db.Char(36)
  code               String         @unique @db.VarChar(50)
  title              String         @db.VarChar(250)
  description        String?        @db.Text
  categoryId         String?        @db.Char(36)
  mode               ExamMode       @default(REAL)
  accessType         ExamAccessType @default(SCHEDULED)
  durationMinutes    Int
  sectionTiming      Boolean        @default(false)
  allowBreaks        Boolean        @default(false)
  breakMinutes       Int            @default(0)
  passingScore       Decimal        @default(50) @db.Decimal(5, 2)
  maxAttempts        Int            @default(1)
  shuffleQuestions   Boolean        @default(true)
  shuffleChoices     Boolean        @default(true)
  adaptive           Boolean        @default(false)
  negativeMarking    Boolean        @default(false)
  gracePeriodSeconds Int            @default(30)
  lateEntryMinutes   Int            @default(0)
  allowResume        Boolean        @default(true)
  autoSubmit         Boolean        @default(true)
  showResults        Boolean        @default(false)
  certificateEnabled Boolean        @default(false)
  retakePolicy       Json?
  instructions       String?        @db.LongText
  settings           Json?
  isPublished        Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  category        ExamCategory?      @relation(fields: [categoryId], references: [id])
  sections        ExamSection[]
  questionRules   ExamQuestionRule[]
  sessions        ExamSession[]
  certificateTpl  CertificateTemplate?

  @@index([mode, isPublished])
  @@index([categoryId])
  @@map("exam_templates")
}

model ExamSection {
  id              String   @id @default(uuid()) @db.Char(36)
  examTemplateId  String   @db.Char(36)
  title           String   @db.VarChar(200)
  description     String?  @db.Text
  sortOrder       Int      @default(0)
  durationMinutes Int?
  questionCount   Int?
  points          Decimal? @db.Decimal(10, 2)
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examTemplate ExamTemplate       @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  rules        ExamQuestionRule[]

  @@index([examTemplateId, sortOrder])
  @@map("exam_sections")
}

model ExamQuestionRule {
  id             String      @id @default(uuid()) @db.Char(36)
  examTemplateId String      @db.Char(36)
  sectionId      String?     @db.Char(36)
  questionId     String?     @db.Char(36)
  poolBankId     String?     @db.Char(36)
  poolTopicId    String?     @db.Char(36)
  poolDifficulty Difficulty?
  poolType       QuestionType?
  poolCount      Int?
  points         Decimal     @default(1) @db.Decimal(10, 2)
  negativePoints Decimal     @default(0) @db.Decimal(10, 2)
  sortOrder      Int         @default(0)
  isMandatory    Boolean     @default(true)
  createdAt      DateTime    @default(now())

  examTemplate ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)
  section      ExamSection? @relation(fields: [sectionId], references: [id])
  question     Question?    @relation(fields: [questionId], references: [id])

  @@index([examTemplateId, sortOrder])
  @@index([sectionId])
  @@map("exam_question_rules")
}

model ExamSession {
  id               String            @id @default(uuid()) @db.Char(36)
  examTemplateId   String            @db.Char(36)
  name             String            @db.VarChar(200)
  status           ExamSessionStatus @default(DRAFT)
  startsAt         DateTime?
  endsAt           DateTime?
  timezone         String            @default("UTC") @db.VarChar(64)
  maxCandidates    Int?
  accessCodeHash   String?           @db.VarChar(128)
  settingsOverride Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  examTemplate ExamTemplate     @relation(fields: [examTemplateId], references: [id])
  invitations  ExamInvitation[]
  accessCodes  AccessCode[]
  attempts     ExamAttempt[]
  announcements Announcement[]

  @@index([examTemplateId, status])
  @@index([startsAt, endsAt])
  @@map("exam_sessions")
}

model ExamInvitation {
  id            String    @id @default(uuid()) @db.Char(36)
  examSessionId String    @db.Char(36)
  candidateId   String    @db.Char(36)
  email         String    @db.VarChar(320)
  tokenHash     String    @unique @db.VarChar(128)
  expiresAt     DateTime?
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id])

  @@unique([examSessionId, candidateId])
  @@index([candidateId])
  @@map("exam_invitations")
}

model AccessCode {
  id            String    @id @default(uuid()) @db.Char(36)
  examSessionId String    @db.Char(36)
  codeHash      String    @db.VarChar(128)
  label         String?   @db.VarChar(100)
  maxUses       Int?
  useCount      Int       @default(0)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)

  @@index([examSessionId])
  @@map("access_codes")
}

model ExamAttempt {
  id              String        @id @default(uuid()) @db.Char(36)
  examSessionId   String        @db.Char(36)
  candidateId     String        @db.Char(36)
  userId          String        @db.Char(36)
  attemptNumber   Int           @default(1)
  status          AttemptStatus @default(NOT_STARTED)
  startedAt       DateTime?
  endsAt          DateTime?
  submittedAt     DateTime?
  lastActivityAt  DateTime?
  timeSpentSeconds Int          @default(0)
  ipAddress       String?       @db.VarChar(45)
  userAgent       String?       @db.VarChar(500)
  deviceFingerprint String?     @db.VarChar(128)
  questionOrder   Json?
  choiceOrders    Json?
  currentSectionId String?      @db.Char(36)
  scoreRaw        Decimal?      @db.Decimal(10, 2)
  scorePercent    Decimal?      @db.Decimal(5, 2)
  passed          Boolean?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  examSession ExamSession      @relation(fields: [examSessionId], references: [id])
  candidate   Candidate        @relation(fields: [candidateId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  answers     AttemptAnswer[]
  bookmarks   Bookmark[]
  flags       Flag[]
  breaks      BreakRecord[]
  result      Result?
  proctorSession ProctorSession?
  reviewItems ManualReviewItem[]

  @@unique([examSessionId, candidateId, attemptNumber])
  @@index([userId, status])
  @@index([status, endsAt])
  @@index([examSessionId, status])
  @@map("exam_attempts")
}

model AttemptAnswer {
  id              String    @id @default(uuid()) @db.Char(36)
  attemptId       String    @db.Char(36)
  questionId      String    @db.Char(36)
  sectionId       String?   @db.Char(36)
  response        Json?
  isCorrect       Boolean?
  scoreAwarded    Decimal?  @db.Decimal(10, 4)
  maxScore        Decimal   @default(1) @db.Decimal(10, 2)
  timeSpentSeconds Int      @default(0)
  answeredAt      DateTime?
  modifiedCount   Int       @default(0)
  needsReview     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId, updatedAt])
  @@index([needsReview])
  @@map("attempt_answers")
}

model Bookmark {
  id         String   @id @default(uuid()) @db.Char(36)
  attemptId  String   @db.Char(36)
  questionId String   @db.Char(36)
  note       String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("bookmarks")
}

model Flag {
  id         String   @id @default(uuid()) @db.Char(36)
  attemptId  String   @db.Char(36)
  questionId String   @db.Char(36)
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("flags")
}

model BreakRecord {
  id        String    @id @default(uuid()) @db.Char(36)
  attemptId String    @db.Char(36)
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("break_records")
}

// =============================================================================
// RESULTS & CERTIFICATES
// =============================================================================

model Result {
  id            String   @id @default(uuid()) @db.Char(36)
  attemptId     String   @unique @db.Char(36)
  totalScore    Decimal  @db.Decimal(10, 2)
  maxScore      Decimal  @db.Decimal(10, 2)
  percent       Decimal  @db.Decimal(5, 2)
  passed        Boolean
  sectionScores Json?
  topicScores   Json?
  gradedAt      DateTime @default(now())
  gradedById    String?  @db.Char(36)
  reportData    Json?
  createdAt     DateTime @default(now())

  attempt     ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  certificate Certificate?

  @@index([passed, gradedAt])
  @@map("results")
}

model ManualReviewItem {
  id         String    @id @default(uuid()) @db.Char(36)
  attemptId  String    @db.Char(36)
  answerId   String    @db.Char(36)
  status     String    @default("PENDING") @db.VarChar(30)
  reviewerId String?   @db.Char(36)
  score      Decimal?  @db.Decimal(10, 4)
  feedback   String?   @db.Text
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([attemptId])
  @@map("manual_review_items")
}

model CertificateTemplate {
  id             String   @id @default(uuid()) @db.Char(36)
  examTemplateId String   @unique @db.Char(36)
  name           String   @db.VarChar(200)
  htmlTemplate   String   @db.LongText
  css            String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  examTemplate ExamTemplate @relation(fields: [examTemplateId], references: [id], onDelete: Cascade)

  @@map("certificate_templates")
}

model Certificate {
  id            String    @id @default(uuid()) @db.Char(36)
  resultId      String    @unique @db.Char(36)
  userId        String    @db.Char(36)
  certificateNo String    @unique @db.VarChar(64)
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  pdfStorageKey String?   @db.VarChar(500)
  verificationCode String @unique @db.VarChar(64)
  revokedAt     DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())

  result Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("certificates")
}

// =============================================================================
// PROCTORING
// =============================================================================

enum ProctorEventType {
  FULLSCREEN_EXIT
  TAB_SWITCH
  DEVTOOLS_OPEN
  CLIPBOARD_COPY
  CLIPBOARD_PASTE
  RIGHT_CLICK
  SCREEN_CAPTURE
  FACE_MISSING
  MULTIPLE_FACES
  VOICE_DETECTED
  FOCUS_LOST
  FOCUS_GAINED
  MOUSE_IDLE
  KEYBOARD_IDLE
  IP_CHANGE
  DEVICE_CHANGE
  VPN_SUSPECTED
  LOCATION_CHANGE
  RECONNECT
  CUSTOM
}

model ProctorSession {
  id              String   @id @default(uuid()) @db.Char(36)
  attemptId       String   @unique @db.Char(36)
  proctorUserId   String?  @db.Char(36)
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  cheatingScore   Decimal  @default(0) @db.Decimal(5, 2)
  status          String   @default("ACTIVE") @db.VarChar(30)
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempt     ExamAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  proctorUser User?          @relation("ProctorUser", fields: [proctorUserId], references: [id])
  events      ProctorEvent[]
  flags       ProctorFlag[]
  focusEvents FocusEvent[]
  locationLogs LocationLog[]

  @@index([proctorUserId, status])
  @@map("proctor_sessions")
}

model ProctorEvent {
  id               String           @id @default(uuid()) @db.Char(36)
  proctorSessionId String           @db.Char(36)
  type             ProctorEventType
  severity         Int              @default(1)
  payload          Json?
  clientTimestamp  DateTime?
  createdAt        DateTime         @default(now())

  proctorSession ProctorSession @relation(fields: [proctorSessionId], references: [id], onDelete: Cascade)

  @@index([proctorSessionId, createdAt])
  @@index([type])
  @@map("proctor_events")
}

model ProctorFlag {
  id               String    @id @default(uuid()) @db.Char(36)
  proctorSessionId String    @db.Char(36)
  reason           String    @db.VarChar(200)
  severity         Int       @default(1)
  autoGenerated    Boolean   @default(true)
  resolvedAt       DateTime?
  resolvedById     String?   @db.Char(36)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())

  proctorSession ProctorSession @relation(fields: [proctorSessionId], references: [id], onDelete: Cascade)

  @@index([proctorSessionId, severity])
  @@map("proctor_flags")
}

model FocusEvent {
  id               String   @id @default(uuid()) @db.Char(36)
  proctorSessionId String   @db.Char(36)
  event            String   @db.VarChar(40)
  durationMs       Int?
  createdAt        DateTime @default(now())

  proctorSession ProctorSession @relation(fields: [proctorSessionId], references: [id], onDelete: Cascade)

  @@index([proctorSessionId, createdAt])
  @@map("focus_events")
}

model LocationLog {
  id               String   @id @default(uuid()) @db.Char(36)
  proctorSessionId String   @db.Char(36)
  ipAddress        String   @db.VarChar(45)
  country          String?  @db.VarChar(2)
  region           String?  @db.VarChar(100)
  city             String?  @db.VarChar(100)
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  vpnSuspected     Boolean  @default(false)
  createdAt        DateTime @default(now())

  proctorSession ProctorSession @relation(fields: [proctorSessionId], references: [id], onDelete: Cascade)

  @@index([proctorSessionId, createdAt])
  @@map("location_logs")
}

// =============================================================================
// BILLING
// =============================================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

model Product {
  id          String    @id @default(uuid()) @db.Char(36)
  sku         String    @unique @db.VarChar(50)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  priceCents  Int
  currency    String    @default("USD") @db.VarChar(3)
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  invoiceLines InvoiceLine[]

  @@map("products")
}

model Coupon {
  id            String    @id @default(uuid()) @db.Char(36)
  code          String    @unique @db.VarChar(50)
  description   String?   @db.VarChar(200)
  percentOff    Decimal?  @db.Decimal(5, 2)
  amountOffCents Int?
  currency      String?   @db.VarChar(3)
  maxRedemptions Int?
  redemptionCount Int     @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]
  invoices Invoice[]

  @@map("coupons")
}

model Payment {
  id                String        @id @default(uuid()) @db.Char(36)
  userId            String        @db.Char(36)
  invoiceId         String?       @db.Char(36)
  couponId          String?       @db.Char(36)
  provider          String        @db.VarChar(40)
  providerPaymentId String?       @db.VarChar(200)
  amountCents       Int
  currency          String        @default("USD") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  failureReason     String?       @db.VarChar(500)
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id])

  @@index([userId, status])
  @@index([providerPaymentId])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Char(36)
  userId        String        @db.Char(36)
  couponId      String?       @db.Char(36)
  number        String        @unique @db.VarChar(40)
  status        InvoiceStatus @default(DRAFT)
  subtotalCents Int
  discountCents Int           @default(0)
  taxCents      Int           @default(0)
  totalCents    Int
  currency      String        @default("USD") @db.VarChar(3)
  dueAt         DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  pdfStorageKey String?       @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  coupon  Coupon?       @relation(fields: [couponId], references: [id])
  lines   InvoiceLine[]
  payments Payment[]

  @@index([userId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Char(36)
  invoiceId   String  @db.Char(36)
  productId   String? @db.Char(36)
  description String  @db.VarChar(300)
  quantity    Int     @default(1)
  unitCents   Int
  totalCents  Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

// =============================================================================
// NOTIFICATIONS & COMMS
// =============================================================================

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WEBHOOK
  SLACK
  TEAMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model Notification {
  id        String              @id @default(uuid()) @db.Char(36)
  userId    String?             @db.Char(36)
  channel   NotificationChannel
  template  String?             @db.VarChar(100)
  subject   String?             @db.VarChar(300)
  body      String?             @db.Text
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  error     String?             @db.Text
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([channel, status, createdAt])
  @@map("notifications")
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(150)
  subject   String   @db.VarChar(300)
  bodyHtml  String   @db.LongText
  bodyText  String?  @db.Text
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model SmsTemplate {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(150)
  body      String   @db.VarChar(1000)
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_templates")
}

model Webhook {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @db.VarChar(150)
  url         String    @db.VarChar(1000)
  secretEnc   String?   @db.VarChar(500)
  events      Json
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid()) @db.Char(36)
  webhookId    String    @db.Char(36)
  event        String    @db.VarChar(100)
  payload      Json
  statusCode   Int?
  responseBody String?   @db.Text
  success      Boolean   @default(false)
  attempts     Int       @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([success, nextRetryAt])
  @@map("webhook_deliveries")
}

model Announcement {
  id            String    @id @default(uuid()) @db.Char(36)
  examSessionId String?   @db.Char(36)
  title         String    @db.VarChar(200)
  body          String    @db.Text
  priority      Int       @default(0)
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  createdById   String?   @db.Char(36)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  examSession ExamSession? @relation(fields: [examSessionId], references: [id])

  @@index([examSessionId, startsAt])
  @@map("announcements")
}

// =============================================================================
// OPS: AUDIT, SUPPORT, PLATFORM
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(80)
  resourceId String?  @db.Char(36)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(100)
  description String?  @db.VarChar(300)
  enabled     Boolean  @default(false)
  rules       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Char(36)
  number       String         @unique @db.VarChar(30)
  requesterId  String         @db.Char(36)
  assigneeId   String?        @db.Char(36)
  subject      String         @db.VarChar(250)
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     String?        @db.VarChar(80)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  closedAt     DateTime?

  requester User             @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages  SupportMessage[]

  @@index([status, priority])
  @@index([requesterId])
  @@index([assigneeId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid()) @db.Char(36)
  ticketId  String   @db.Char(36)
  authorId  String   @db.Char(36)
  body      String   @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model ActivityStream {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @db.Char(36)
  verb      String   @db.VarChar(80)
  objectType String  @db.VarChar(80)
  objectId  String?  @db.Char(36)
  summary   String   @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([objectType, objectId])
  @@map("activity_streams")
}

model BackgroundJob {
  id          String    @id @default(uuid()) @db.Char(36)
  queue       String    @db.VarChar(80)
  jobName     String    @db.VarChar(120)
  bullJobId   String?   @db.VarChar(80)
  status      String    @db.VarChar(30)
  payload     Json?
  result      Json?
  error       String?   @db.Text
  attempts    Int       @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status])
  @@index([bullJobId])
  @@map("background_jobs")
}

model PlatformSettings {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("platform_settings")
}

model Branding {
  id              String   @id @default("00000000-0000-0000-0000-000000000001") @db.Char(36)
  appName         String   @default("CBT Platform") @db.VarChar(150)
  logoUrl         String?  @db.VarChar(500)
  faviconUrl      String?  @db.VarChar(500)
  primaryColor    String   @default("#0F766E") @db.VarChar(20)
  secondaryColor  String   @default("#134E4A") @db.VarChar(20)
  accentColor     String   @default("#F59E0B") @db.VarChar(20)
  loginBackground String?  @db.VarChar(500)
  customCss       String?  @db.Text
  supportEmail    String?  @db.VarChar(320)
  supportUrl      String?  @db.VarChar(500)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("branding")
}
