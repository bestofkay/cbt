# Application
NODE_ENV=development
APP_NAME=CBT Platform
# Default portal for email verification links (candidate app)
APP_URL=http://localhost:5174
API_URL=http://localhost:4000
API_PREFIX=/api/v1

# Web apps
WEB_ADMIN_URL=http://localhost:5173
WEB_CANDIDATE_URL=http://localhost:5174
WEB_PROCTOR_URL=http://localhost:5175

# Database (MySQL 8 — provide your own instance; no Docker required by the app)
DATABASE_URL=mysql://cbt:cbt_secret@localhost:3306/cbt

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# In production: COOKIE_SECURE=true (required unless ALLOW_INSECURE_COOKIES=true)

# Object Storage (local disk by default)
STORAGE_DRIVER=local
STORAGE_BUCKET=cbt-assets

# Email — console by default (no Mailpit). Set SMTP_MODE=smtp + SMTP_HOST for real delivery.
SMTP_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cbt.local
SMTP_SECURE=false

# SMS (console by default)
SMS_PROVIDER=console
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/microsoft/callback

# LDAP / SAML hooks (optional)
LDAP_ENABLED=false
LDAP_URL=
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=

# Payment
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
OTEL_ENABLED=false
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Encryption (AES-256-GCM key, 32 bytes hex) — MUST be unique in production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Production toggles (defaults: docs on & simulated payments allowed in non-production)
# ENABLE_API_DOCS=false
# ALLOW_SIMULATED_PAYMENTS=false
# ALLOW_INSECURE_COOKIES=false
